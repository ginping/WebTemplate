{
  "name": "web-template",
  "version": "0.1.0",
  "description": "Production-minded Next.js starter for lightweight Cloudflare applications.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ginping/WebTemplate.git"
  },
  "bugs": {
    "url": "https://github.com/ginping/WebTemplate/issues"
  },
  "homepage": "https://github.com/ginping/WebTemplate#readme",
  "keywords": [
    "nextjs",
    "cloudflare-workers",
    "starter",
    "template"
  ],
  "scripts": {
    "bootstrap": "node scripts/install-git-hooks.mjs",
    "dev": "next dev --turbopack",
    "dev:test": "next dev --turbopack --port 3100",
    "build": "next build",
    "start": "next start",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview": "pnpm build:cloudflare && wrangler dev",
    "deploy": "pnpm build:cloudflare && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv",
    "format": "biome check --write .",
    "format:check": "biome format .",
    "lint": "eslint . --max-warnings=0 && biome lint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "docs:check": "node scripts/docs-check.mjs",
    "check:fast": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm docs:check",
    "check": "pnpm check:fast && pnpm build && pnpm test:e2e"
  },
  "dependencies": {
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.4",
    "@opennextjs/cloudflare": "^1.20.14",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  },
  "packageManager": "pnpm@10.6.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
