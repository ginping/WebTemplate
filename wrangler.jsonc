{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-template",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ENV": "production",
    "SITE_URL": "https://web-template.example.com"
  }
}
